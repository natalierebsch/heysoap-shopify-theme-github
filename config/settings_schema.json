[
  {
    "name": "theme_info",
    "theme_name": "Themekit template theme",
    "theme_version": "1.0.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://github.com/Shopify/themekit",
    "theme_support_url": "https://github.com/Shopify/themekit/issues"
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "color",
        "id": "page_background_color",
        "label": "Seitenhintergrund"
      },
      {
        "type": "select",
        "id": "page_width",
        "label": "Seitenbreite",
        "options": [
          {
            "value": "1440px",
            "label": "Schmal"
          },
          {
            "value": "1920px",
            "label": "Normal"
          },
          {
            "value": "2400px",
            "label": "Breit"
          }
        ],
        "default": "1920px"
      }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Hintergrund",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#121212"
          }
        ],
        "role": {
          "background": {
            "solid": "background"
          },
          "text": "text",
          "links": "text",
          "icons": "text",
          "primary_button": "text",
          "on_primary_button": "background",
          "primary_button_border": "text",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading 1"
      },
      {
        "type": "font_picker",
        "id": "h1_font",
        "label": "Font",
        "default": "work_sans_n7"
      },
      {
        "type": "range",
        "id": "h1_size",
        "label": "Font size",
        "min": 24,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "range",
        "id": "h1_line_height",
        "label": "Line height",
        "min": 90,
        "max": 160,
        "step": 5,
        "unit": "%",
        "default": 110
      },
      {
        "type": "header",
        "content": "Heading 2"
      },
      {
        "type": "font_picker",
        "id": "h2_font",
        "label": "Font",
        "default": "work_sans_n7"
      },
      {
        "type": "range",
        "id": "h2_size",
        "label": "Font size",
        "min": 18,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "h2_line_height",
        "label": "Line height",
        "min": 90,
        "max": 160,
        "step": 5,
        "unit": "%",
        "default": 120
      },
      {
        "type": "header",
        "content": "Paragraph"
      },
      {
        "type": "font_picker",
        "id": "paragraph_font",
        "label": "Font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "paragraph_size",
        "label": "Font size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "paragraph_line_height",
        "label": "Line height",
        "min": 100,
        "max": 200,
        "step": 5,
        "unit": "%",
        "default": 150
      }
    ]
  }
]
