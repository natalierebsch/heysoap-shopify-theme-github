<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <title>{{ page_title }}</title>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="{{ page_description | escape }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="canonical" href="{{ canonical_url }}">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% liquid
      assign h1_font_bold = settings.h1_font | font_modify: 'weight', 'bold'
      assign h2_font_bold = settings.h2_font | font_modify: 'weight', 'bold'
      assign paragraph_font_bold = settings.paragraph_font | font_modify: 'weight', 'bold'
      assign paragraph_font_italic = settings.paragraph_font | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.h1_font | font_face: font_display: 'swap' }}

      {% if h1_font_bold %}
        {{ h1_font_bold | font_face: font_display: 'swap' }}
      {% endif %}

      {{ settings.h2_font | font_face: font_display: 'swap' }}

      {% if h2_font_bold %}
        {{ h2_font_bold | font_face: font_display: 'swap' }}
      {% endif %}

      {{ settings.paragraph_font | font_face: font_display: 'swap' }}

      {% if paragraph_font_bold %}
        {{ paragraph_font_bold | font_face: font_display: 'swap' }}
      {% endif %}

      {% if paragraph_font_italic %}
        {{ paragraph_font_italic | font_face: font_display: 'swap' }}
      {% endif %}

      :root {
        --page-background-color: {{ settings.page_background_color | default: 'transparent' }};
        --page-width: {{ settings.page_width | default: '1920px' }};

        --font-h1-family: {{ settings.h1_font.family }}, {{ settings.h1_font.fallback_families }};
        --font-h1-style: {{ settings.h1_font.style }};
        --font-h1-weight: {{ settings.h1_font.weight }};
        --font-h1-size: {{ settings.h1_size }}px;
        --font-h1-line-height: {{ settings.h1_line_height | divided_by: 100.0 }};

        --font-h2-family: {{ settings.h2_font.family }}, {{ settings.h2_font.fallback_families }};
        --font-h2-style: {{ settings.h2_font.style }};
        --font-h2-weight: {{ settings.h2_font.weight }};
        --font-h2-size: {{ settings.h2_size }}px;
        --font-h2-line-height: {{ settings.h2_line_height | divided_by: 100.0 }};

        --font-paragraph-family: {{ settings.paragraph_font.family }}, {{ settings.paragraph_font.fallback_families }};
        --font-paragraph-style: {{ settings.paragraph_font.style }};
        --font-paragraph-weight: {{ settings.paragraph_font.weight }};
        --font-paragraph-size: {{ settings.paragraph_size }}px;
        --font-paragraph-line-height: {{ settings.paragraph_line_height | divided_by: 100.0 }};
      }

      body {
        margin: 0;
        background-color: var(--page-background-color);
        overflow-x: clip;
        container-type: inline-size;
        font-family: var(--font-paragraph-family);
        font-style: var(--font-paragraph-style);
        font-weight: var(--font-paragraph-weight);
        font-size: var(--font-paragraph-size);
        line-height: var(--font-paragraph-line-height);
      }

      .site-main {
        box-sizing: border-box;
        width: 100%;
        max-width: var(--page-width);
        margin-inline: auto;
      }

      h1 {
        font-family: var(--font-h1-family);
        font-style: var(--font-h1-style);
        font-weight: var(--font-h1-weight);
        font-size: var(--font-h1-size);
        line-height: var(--font-h1-line-height);
      }

      h2 {
        font-family: var(--font-h2-family);
        font-style: var(--font-h2-style);
        font-weight: var(--font-h2-weight);
        font-size: var(--font-h2-size);
        line-height: var(--font-h2-line-height);
      }

      p {
        font-family: var(--font-paragraph-family);
        font-style: var(--font-paragraph-style);
        font-weight: var(--font-paragraph-weight);
        font-size: var(--font-paragraph-size);
        line-height: var(--font-paragraph-line-height);
      }

      [x-cloak] {
        display: none !important;
      }
    {% endstyle %}

    <script src="{{ 'application.js' | asset_url }}" defer></script>
    <script
      src="https://cdn.jsdelivr.net/gh/alpinejs/alpine@v2.8.2/dist/alpine.min.js"
      defer
    ></script>
  </head>

  <body>
    {% section 'header' %}

    <main class="site-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
