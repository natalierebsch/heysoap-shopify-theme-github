{% doc %}
  Rendert den Karteninhalt innerhalb der Karussell-Section.

  @example
  {% content_for 'block', type: 'carousel-content', id: 'carousel-content' %}
{% enddoc %}

<div class="carousel-content" {{ block.shopify_attributes }}>
  <div class="carousel-content__viewport">
    <div class="carousel-content__track" data-carousel-track>
      {% content_for 'blocks' %}
    </div>
  </div>

  <button
    class="carousel-content__arrow carousel-content__arrow--previous"
    type="button"
    data-carousel-direction="-1"
    aria-label="Vorherige Karten"
  >
    {% if section.settings.navigation_symbol == 'chevrons' %}
      &#10094;
    {% else %}
      &larr;
    {% endif %}
  </button>

  <button
    class="carousel-content__arrow carousel-content__arrow--next"
    type="button"
    data-carousel-direction="1"
    aria-label="Nächste Karten"
  >
    {% if section.settings.navigation_symbol == 'chevrons' %}
      &#10095;
    {% else %}
      &rarr;
    {% endif %}
  </button>
</div>

{% stylesheet %}
  .carousel-content {
    position: relative;
    width: 100%;
  }

  .carousel-content__viewport {
    width: 100%;
    overflow: hidden;
  }

  .carousel-content__track {
    display: flex;
    gap: var(--carousel-card-gap);
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel-content__track::-webkit-scrollbar {
    display: none;
  }

  .carousel-content__track > .shopify-block {
    flex: 0 0 calc(
      (
        100% - (
          var(--carousel-card-gap) *
          (var(--carousel-columns-desktop) - 1)
        )
      ) / var(--carousel-columns-desktop)
    );
    min-width: 0;
    scroll-snap-align: start;
  }

  .carousel-content__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 15%);
    background: #ffffff;
    color: #111111;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
    transform: translateY(-50%);
  }

  .carousel-content__arrow--previous {
    left: 10px;
  }

  .carousel-content__arrow--next {
    right: 10px;
  }

  @media screen and (max-width: 749px) {
    .carousel-content__track > .shopify-block {
      flex-basis: calc(
        (
          100% - (
            var(--carousel-card-gap) *
            (var(--carousel-columns-mobile) - 1)
          )
        ) / var(--carousel-columns-mobile)
      );
    }
  }
{% endstylesheet %}

