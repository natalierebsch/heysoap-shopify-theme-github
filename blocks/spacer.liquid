<div
  class="spacer-block"
  style="
    --spacer-desktop: {{ block.settings.height_desktop }}px;
    --spacer-mobile: {{ block.settings.height_mobile }}px;
  "
  {{ block.shopify_attributes }}
></div>

{% stylesheet %}
  .spacer-block {
    height: var(--spacer-desktop);
  }

  @media screen and (max-width: 749px) {
    .spacer-block {
      height: var(--spacer-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Abstand",
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Höhe Desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Höhe Mobil",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Abstand"
    }
  ]
}
{% endschema %}