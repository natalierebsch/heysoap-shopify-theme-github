<div
  class="spacer-block"
  style="
    --spacer-desktop: {{ block.settings.height_desktop }}px;
    --spacer-mobile: {% if block.settings.custom_mobile_size %}{{ block.settings.height_mobile }}{% else %}{{ block.settings.height_desktop }}{% endif %}px;
  "
  {{ block.shopify_attributes }}
  aria-hidden="true"
></div>

{% stylesheet %}
  .spacer-block {
    height: var(--spacer-desktop);
  }

  @media screen and (max-width: 749px) {
    .spacer-block {
      height: var(--spacer-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Abstand",
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Höhe Desktop",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_size",
      "label": "Eigene Höhe für Mobilgeräte",
      "default": true
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Höhe Mobil",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.custom_mobile_size }}"
    }
  ],
  "presets": [
    {
      "name": "Abstand"
    }
  ]
}
{% endschema %}
