{% doc %}
  Rendert die gemeinsame Produktkartenvorlage einer Featured Collection.
{% enddoc %}

{% assign featured_product = closest.product %}

{% capture product_image %}
  {% content_for 'block',
    type: '_product-card-image',
    id: 'product-card-image',
    closest.product: featured_product,
    parent_block_id: block.id
  %}
{% endcapture %}

{% capture product_title %}
  {% content_for 'block',
    type: 'product-title',
    id: 'product-title',
    closest.product: featured_product,
    parent_block_id: block.id
  %}
{% endcapture %}

{% capture product_text %}
  {% content_for 'block',
    type: 'product-text',
    id: 'product-text',
    closest.product: featured_product,
    parent_block_id: block.id
  %}
{% endcapture %}

{% capture product_price %}
  {% content_for 'block',
    type: 'product-price',
    id: 'product-price',
    closest.product: featured_product,
    parent_block_id: block.id
  %}
{% endcapture %}

<article
  class="
    featured-product-card
    featured-product-card--desktop-{{ block.settings.width }}
    featured-product-card--mobile-{{ block.settings.width_mobile }}
    featured-product-card--border-{{ block.settings.border }}
  "
  style="
    --featured-card-gap: {{ block.settings.gap }}px;
    --featured-card-custom-width: {{ block.settings.custom_width }}%;
    --featured-card-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    --featured-card-background: {{ block.settings.background_color | default: 'transparent' }};
    --featured-card-radius: {{ block.settings.border_radius }}px;
    --featured-card-border-width: {{ block.settings.border_width }}px;
    --featured-card-border-color: {{ block.settings.border_color | default: 'currentColor' }};
    --featured-card-border-opacity: {{ block.settings.border_opacity }}%;
    --featured-card-padding-top: {{ block.settings.padding_top }}px;
    --featured-card-padding-bottom: {{ block.settings.padding_bottom }}px;
    --featured-card-padding-left: {{ block.settings.padding_left }}px;
    --featured-card-padding-right: {{ block.settings.padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  {{ product_image }}
  {{ product_title }}
  {{ product_text }}
  {{ product_price }}
  {% content_for 'blocks', closest.product: featured_product %}
</article>

{% stylesheet %}
  .featured-product-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--featured-card-gap);
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--featured-card-background);
    border-radius: var(--featured-card-radius);
    padding:
      var(--featured-card-padding-top)
      var(--featured-card-padding-right)
      var(--featured-card-padding-bottom)
      var(--featured-card-padding-left);
  }

  .featured-product-card--desktop-fit {
    width: fit-content;
  }

  .featured-product-card--desktop-fill {
    width: 100%;
  }

  .featured-product-card--desktop-custom {
    width: var(--featured-card-custom-width);
  }

  .featured-product-card--border-solid {
    border:
      var(--featured-card-border-width)
      solid
      color-mix(
        in srgb,
        var(--featured-card-border-color) var(--featured-card-border-opacity),
        transparent
      );
  }

  .featured-product-card > .shopify-block {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .featured-product-card--mobile-fit {
      width: fit-content;
    }

    .featured-product-card--mobile-fill {
      width: 100%;
    }

    .featured-product-card--mobile-custom {
      width: var(--featured-card-custom-width-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produktkarte",
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "image" },
    { "type": "spacer" }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Vertikaler Abstand",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Größe"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Desktop-Breite",
      "options": [
        {
          "value": "fit",
          "label": "Anpassen"
        },
        {
          "value": "fill",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Mobile Breite",
      "options": [
        {
          "value": "fit",
          "label": "Anpassen"
        },
        {
          "value": "fill",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte Mobile Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Erscheinungsbild"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "header",
      "content": "Ränder"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Stil",
      "options": [
        { "value": "none", "label": "Keine" },
        { "value": "solid", "label": "Einfarbig" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Stärke",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Deckkraft",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Farbe",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
