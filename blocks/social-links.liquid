<nav
  class="social-links-block social-links-block--{{ block.settings.alignment }}"
  style="--social-gap: {{ block.settings.gap }}px; --social-size: {{ block.settings.text_size }}px;"
  aria-label="Social Media"
  {{ block.shopify_attributes }}
>
  {% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
  {% if block.settings.tiktok != blank %}<a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
  {% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
  {% if block.settings.pinterest != blank %}<a href="{{ block.settings.pinterest }}" target="_blank" rel="noopener">Pinterest</a>{% endif %}
  {% if block.settings.youtube != blank %}<a href="{{ block.settings.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
</nav>

{% stylesheet %}
  .social-links-block { display: flex; flex-wrap: wrap; gap: var(--social-gap); width: 100%; font-size: var(--social-size); }
  .social-links-block--left { justify-content: flex-start; }
  .social-links-block--center { justify-content: center; }
  .social-links-block--right { justify-content: flex-end; }
  .social-links-block a { color: inherit; text-decoration: none; }
  .social-links-block a:hover { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Social Links",
  "tag": null,
  "settings": [
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "text_alignment", "id": "alignment", "label": "Ausrichtung", "default": "left" },
    { "type": "range", "id": "gap", "label": "Abstand", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "text_size", "label": "Textgröße", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 14 }
  ],
  "presets": [{ "name": "Social Links" }]
}
{% endschema %}
