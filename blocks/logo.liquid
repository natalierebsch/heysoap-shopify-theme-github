{% if block.settings.logo != blank %}
  <div
    class="logo-block"
    style="
      --logo-width-desktop: {{ block.settings.width_desktop }}px;
      --logo-width-mobile: {{ block.settings.width_mobile }}px;
      --logo-alignment: {{ block.settings.alignment }};
    "
    {{ block.shopify_attributes }}
  >
    {% if block.settings.link_to_home %}
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {% endif %}

    {{
      block.settings.logo
      | image_url: width: 1000
      | image_tag:
        class: 'logo-block__image',
        loading: 'lazy',
        widths: '100, 200, 300, 400, 600, 800, 1000',
        alt: shop.name
    }}

    {% if block.settings.link_to_home %}
      </a>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .logo-block {
    display: flex;
    justify-content: var(--logo-alignment);
  }

  .logo-block__image {
    display: block;
    width: var(--logo-width-desktop);
    max-width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .logo-block__image {
      width: var(--logo-width-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "width_desktop",
      "label": "Breite Desktop",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "width_mobile",
      "label": "Breite Mobil",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "flex-start",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Mittig"
        },
        {
          "value": "flex-end",
          "label": "Rechts"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "link_to_home",
      "label": "Mit Startseite verlinken",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Logo"
    }
  ]
}
{% endschema %}