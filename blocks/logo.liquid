{% liquid
  assign logo_image = block.settings.logo
  if block.settings.use_alternate_logo and block.settings.alternate_logo != blank
    assign logo_image = block.settings.alternate_logo
  endif
%}

<div
  class="
    logo-block
    logo-block--desktop-{{ block.settings.desktop_width }}
    logo-block--mobile-{{ block.settings.mobile_width }}
  "
  style="
    --logo-custom-width-desktop: {{ block.settings.custom_width_desktop }}%;
    --logo-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    --logo-alignment: {{ block.settings.alignment }};
    --logo-padding-top: {{ block.settings.padding_top }}px;
    --logo-padding-bottom: {{ block.settings.padding_bottom }}px;
    --logo-padding-left: {{ block.settings.padding_left }}px;
    --logo-padding-right: {{ block.settings.padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.link_to_home %}
    <a class="logo-block__link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
  {% endif %}

  {% if logo_image != blank %}
    {{
      logo_image
      | image_url: width: 1000
      | image_tag:
        class: 'logo-block__image',
        loading: 'lazy',
        widths: '100, 200, 300, 400, 600, 800, 1000',
        alt: shop.name
    }}
  {% else %}
    <span class="logo-block__text">{{ shop.name }}</span>
  {% endif %}

  {% if block.settings.link_to_home %}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .logo-block {
    box-sizing: border-box;
    display: flex;
    justify-content: var(--logo-alignment);
    max-width: 100%;
    padding:
      var(--logo-padding-top)
      var(--logo-padding-right)
      var(--logo-padding-bottom)
      var(--logo-padding-left);
  }

  .logo-block__link {
    display: flex;
    width: 100%;
    justify-content: inherit;
    color: inherit;
    text-decoration: none;
  }

  .logo-block__image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .logo-block__text {
    font-family: var(--font-h1-family);
    font-style: var(--font-h1-style);
    font-weight: var(--font-h1-weight);
    font-size: var(--font-h2-size);
    line-height: var(--font-h2-line-height);
  }

  .logo-block--desktop-fit {
    width: fit-content;
  }

  .logo-block--desktop-fill {
    width: 100%;
  }

  .logo-block--desktop-custom {
    width: var(--logo-custom-width-desktop);
  }

  .logo-block--desktop-fill .logo-block__image,
  .logo-block--desktop-custom .logo-block__image {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .logo-block--mobile-fit {
      width: fit-content;
    }

    .logo-block--mobile-fill {
      width: 100%;
    }

    .logo-block--mobile-custom {
      width: var(--logo-custom-width-mobile);
    }

    .logo-block--mobile-fill .logo-block__image,
    .logo-block--mobile-custom .logo-block__image {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "alternate_logo",
      "label": "Alternatives Logo"
    },
    {
      "type": "checkbox",
      "id": "use_alternate_logo",
      "label": "Alternatives Logo verwenden",
      "default": false,
      "visible_if": "{{ block.settings.alternate_logo != blank }}"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop-Breite",
      "options": [
        {
          "value": "fit",
          "label": "Anpassen"
        },
        {
          "value": "fill",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_width_desktop",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ block.settings.desktop_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile Breite",
      "options": [
        {
          "value": "fit",
          "label": "Anpassen"
        },
        {
          "value": "fill",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte Mobile Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.mobile_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "flex-start",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Mittig"
        },
        {
          "value": "flex-end",
          "label": "Rechts"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "link_to_home",
      "label": "Mit Startseite verlinken",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Logo"
    }
  ]
}
{% endschema %}
