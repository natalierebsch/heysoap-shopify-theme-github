{% liquid
  assign video_border_alpha = block.settings.border_opacity | divided_by: 100.0
  assign video_border_color = block.settings.border_color | default: '#000000'
  assign video_border_color = video_border_color | color_modify: 'alpha', video_border_alpha

  assign external_autoplay = block.settings.video_autoplay
  if block.settings.source == 'url' and block.settings.cover_image != blank
    assign external_autoplay = true
  endif
%}

<div
  class="
    video-block
    video-block--desktop-{{ block.settings.desktop_width }}
    video-block--mobile-{{ block.settings.mobile_width }}
    video-block--border-{{ block.settings.border }}
    {% unless block.settings.aspect_ratio == 'auto' %}video-block--fixed-ratio{% endunless %}
  "
  style="
    --video-width-desktop: {{ block.settings.custom_width_desktop }}%;
    --video-width-mobile: {{ block.settings.custom_width_mobile }}%;
    --video-ratio: {{ block.settings.aspect_ratio }};
    --video-border-width: {{ block.settings.border_width }}px;
    --video-border-color: {{ video_border_color }};
    --video-radius: {{ block.settings.border_radius }}px;
    --video-padding-top: {{ block.settings.padding_top }}px;
    --video-padding-bottom: {{ block.settings.padding_bottom }}px;
    --video-padding-left: {{ block.settings.padding_left }}px;
    --video-padding-right: {{ block.settings.padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="video-block__media">
    {% if block.settings.source == 'uploaded' and block.settings.video != blank %}
      {{
        block.settings.video
        | video_tag:
          class: 'video-block__video',
          autoplay: block.settings.video_autoplay,
          loop: block.settings.video_loop,
          muted: block.settings.video_autoplay,
          controls: true,
          playsinline: true,
          image_size: '1600x'
      }}
    {% elsif block.settings.source == 'url' and block.settings.video_url != blank %}
      {% capture external_video %}
        {% if block.settings.video_url.type == 'youtube' %}
          {{
            block.settings.video_url
            | external_video_url:
              autoplay: external_autoplay,
              loop: block.settings.video_loop,
              playlist: block.settings.video_url.id,
              mute: external_autoplay
            | external_video_tag:
              class: 'video-block__video',
              title: block.settings.alt
          }}
        {% else %}
          {{
            block.settings.video_url
            | external_video_url:
              autoplay: external_autoplay,
              loop: block.settings.video_loop,
              muted: external_autoplay
            | external_video_tag:
              class: 'video-block__video',
              title: block.settings.alt
          }}
        {% endif %}
      {% endcapture %}

      {% if block.settings.cover_image != blank and block.settings.video_autoplay == false %}
        <details class="video-block__deferred">
          <summary class="video-block__poster">
            {{
              block.settings.cover_image
              | image_url: width: 2000
              | image_tag:
                class: 'video-block__poster-image',
                loading: 'lazy',
                widths: '400, 750, 1000, 1500, 2000',
                sizes: '(max-width: 749px) 100vw, 1200px'
            }}
            <span class="video-block__play" aria-hidden="true">▶</span>
            <span class="video-block__visually-hidden">Video abspielen</span>
          </summary>
          <div class="video-block__external">
            {{ external_video }}
          </div>
        </details>
      {% else %}
        <div class="video-block__external">
          {{ external_video }}
        </div>
      {% endif %}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'video-block__placeholder' }}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .video-block {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    padding:
      var(--video-padding-top)
      var(--video-padding-right)
      var(--video-padding-bottom)
      var(--video-padding-left);
  }

  .video-block--desktop-fit {
    width: fit-content;
  }

  .video-block--desktop-custom {
    width: var(--video-width-desktop);
  }

  .video-block__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--video-radius);
  }

  .video-block--border-solid .video-block__media {
    border: var(--video-border-width) solid var(--video-border-color);
  }

  .video-block--fixed-ratio .video-block__media,
  .video-block--fixed-ratio .video-block__deferred,
  .video-block--fixed-ratio .video-block__external {
    aspect-ratio: var(--video-ratio);
  }

  .video-block__video,
  .video-block__external iframe,
  .video-block__placeholder,
  .video-block__poster-image {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-block__deferred {
    position: relative;
    margin: 0;
  }

  .video-block__poster {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    list-style: none;
  }

  .video-block__poster::-webkit-details-marker {
    display: none;
  }

  .video-block__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 90%);
    color: #111111;
    transform: translate(-50%, -50%);
  }

  .video-block__deferred[open] > .video-block__poster {
    display: none;
  }

  .video-block__external {
    width: 100%;
    min-height: 240px;
  }

  .video-block__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .video-block--mobile-fit {
      width: fit-content;
    }

    .video-block--mobile-fill {
      width: 100%;
    }

    .video-block--mobile-custom {
      width: var(--video-width-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Videoquelle",
      "options": [
        { "value": "uploaded", "label": "Hochgeladenes Video" },
        { "value": "url", "label": "Externe Video-URL" }
      ],
      "default": "uploaded"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube- oder Vimeo-URL",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Automatisch abspielen",
      "info": "Automatisch abgespielte Videos werden stummgeschaltet.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Video wiederholen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Titelbild",
      "visible_if": "{{ block.settings.source == 'url' and block.settings.video_autoplay == false }}"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Videobeschreibung",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "header",
      "content": "Größe"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop-Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_desktop",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.desktop_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte mobile Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.mobile_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Seitenverhältnis",
      "options": [
        { "value": "auto", "label": "Automatisch" },
        { "value": "9 / 16", "label": "Hochformat" },
        { "value": "1 / 1", "label": "Quadrat" },
        { "value": "16 / 9", "label": "Querformat" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "header",
      "content": "Ränder"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Stil",
      "options": [
        { "value": "none", "label": "Keine" },
        { "value": "solid", "label": "Einfarbig" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Stärke",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Deckkraft",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Farbe",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
