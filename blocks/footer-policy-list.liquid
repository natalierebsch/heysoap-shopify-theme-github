{% if shop.policies.size > 0 %}
  <nav class="footer-policy-block footer-policy-block--{{ block.settings.alignment }}" aria-label="Rechtliche Hinweise" {{ block.shopify_attributes }}>
    {% for policy in shop.policies %}
      {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}
    {% endfor %}
  </nav>
{% endif %}

{% stylesheet %}
  .footer-policy-block { display: flex; flex-wrap: wrap; gap: 10px 18px; width: 100%; }
  .footer-policy-block--left { justify-content: flex-start; }
  .footer-policy-block--center { justify-content: center; }
  .footer-policy-block--right { justify-content: flex-end; }
  .footer-policy-block a { color: inherit; text-decoration: none; }
  .footer-policy-block a:hover { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer-Richtlinien",
  "tag": null,
  "settings": [
    { "type": "text_alignment", "id": "alignment", "label": "Ausrichtung", "default": "left" }
  ],
  "presets": [{ "name": "Footer-Richtlinien" }]
}
{% endschema %}
