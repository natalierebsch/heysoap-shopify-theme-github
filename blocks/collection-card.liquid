{% doc %}
  Rendert eine auswählbare Kollektion als Karte.

  Die Karte zeigt automatisch das Kollektionsbild und den Namen der Kollektion.
  Zusätzlich können weitere Theme-Blöcke eingefügt werden.

  @example
  {% content_for 'block', type: 'collection-card', id: 'collection-card' %}
{% enddoc %}

{% liquid
  assign selected_collection = block.settings.collection
%}

{% capture additional_content %}
  {% content_for 'blocks' %}
{% endcapture %}

<article
  class="
    collection-card
    collection-card--placement-{{ block.settings.placement }}
    collection-card--horizontal-{{ block.settings.horizontal_alignment }}
    collection-card--vertical-{{ block.settings.vertical_alignment }}
    collection-card--border-{{ block.settings.border_style }}
  "
  style="
    --collection-card-gap: {{ block.settings.gap }}px;
    --collection-card-ratio: {{ block.settings.aspect_ratio }};
    --collection-card-background: {{ block.settings.background_color | default: 'transparent' }};
    --collection-card-text: {{ block.settings.text_color | default: 'inherit' }};
    --collection-card-border-width: {{ block.settings.border_width }}px;
    --collection-card-border-opacity: {{ block.settings.border_opacity }}%;
    --collection-card-border-color: {{ block.settings.border_color | default: 'currentColor' }};
    --collection-card-radius: {{ block.settings.border_radius }}px;
    --collection-card-padding: {{ block.settings.content_padding }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.placement == 'on_image' %}
    <div class="collection-card__media collection-card__media--overlay">
      {% if selected_collection != blank %}
        {% if selected_collection.image != blank %}
          {{
            selected_collection.image
            | image_url: width: 2000
            | image_tag:
              class: 'collection-card__image',
              loading: 'lazy',
              widths: '400, 750, 1000, 1500, 2000',
              sizes: '(max-width: 749px) 100vw, 50vw',
              alt: selected_collection.title
          }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
        {% endif %}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
      {% endif %}

      <div class="collection-card__overlay"></div>

      <div class="collection-card__content">
        {% if block.settings.show_title %}
          {% if selected_collection != blank %}
            {% case block.settings.title_preset %}
              {% when 'h1' %}
                <h1 class="collection-card__title">
                  <a href="{{ selected_collection.url }}">
                    {{ selected_collection.title }}
                  </a>
                </h1>

              {% when 'h2' %}
                <h2 class="collection-card__title">
                  <a href="{{ selected_collection.url }}">
                    {{ selected_collection.title }}
                  </a>
                </h2>

              {% else %}
                <h3 class="collection-card__title">
                  <a href="{{ selected_collection.url }}">
                    {{ selected_collection.title }}
                  </a>
                </h3>
            {% endcase %}
          {% else %}
            <h3 class="collection-card__title">
              Kollektion auswählen
            </h3>
          {% endif %}
        {% endif %}

        {{ additional_content }}
      </div>
    </div>
  {% else %}
    <div class="collection-card__media">
      {% if selected_collection != blank %}
        <a
          class="collection-card__image-link"
          href="{{ selected_collection.url }}"
          aria-label="{{ selected_collection.title | escape }}"
        >
          {% if selected_collection.image != blank %}
            {{
              selected_collection.image
              | image_url: width: 2000
              | image_tag:
                class: 'collection-card__image',
                loading: 'lazy',
                widths: '400, 750, 1000, 1500, 2000',
                sizes: '(max-width: 749px) 100vw, 50vw',
                alt: selected_collection.title
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
          {% endif %}
        </a>
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
      {% endif %}
    </div>

    <div class="collection-card__content">
      {% if block.settings.show_title %}
        {% if selected_collection != blank %}
          {% case block.settings.title_preset %}
            {% when 'h1' %}
              <h1 class="collection-card__title">
                <a href="{{ selected_collection.url }}">
                  {{ selected_collection.title }}
                </a>
              </h1>

            {% when 'h2' %}
              <h2 class="collection-card__title">
                <a href="{{ selected_collection.url }}">
                  {{ selected_collection.title }}
                </a>
              </h2>

            {% else %}
              <h3 class="collection-card__title">
                <a href="{{ selected_collection.url }}">
                  {{ selected_collection.title }}
                </a>
              </h3>
          {% endcase %}
        {% else %}
          <h3 class="collection-card__title">
            Kollektion auswählen
          </h3>
        {% endif %}
      {% endif %}

      {{ additional_content }}
    </div>
  {% endif %}
</article>

{% stylesheet %}
  .collection-card {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    color: var(--collection-card-text);
    background: var(--collection-card-background);
    border-radius: var(--collection-card-radius);
  }

  .collection-card--border-none {
    border: 0;
  }

  .collection-card--border-solid {
    border:
      var(--collection-card-border-width)
      solid
      color-mix(
        in srgb,
        var(--collection-card-border-color) var(--collection-card-border-opacity),
        transparent
      );
  }

  .collection-card__media {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: var(--collection-card-ratio);
    overflow: hidden;
  }

  .collection-card__media--overlay {
    display: flex;
  }

  .collection-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .collection-card__image,
  .collection-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-card__placeholder {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .collection-card__overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    pointer-events: none;
  }

  .collection-card__content {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--collection-card-gap);
    width: 100%;
    padding: var(--collection-card-padding);
  }

  .collection-card--placement-on_image .collection-card__content {
    position: relative;
    z-index: 2;
    min-height: 100%;
  }

  .collection-card--horizontal-left .collection-card__content {
    align-items: flex-start;
    text-align: left;
  }

  .collection-card--horizontal-center .collection-card__content {
    align-items: center;
    text-align: center;
  }

  .collection-card--horizontal-right .collection-card__content {
    align-items: flex-end;
    text-align: right;
  }

  .collection-card--vertical-top .collection-card__content {
    justify-content: flex-start;
  }

  .collection-card--vertical-center .collection-card__content {
    justify-content: center;
  }

  .collection-card--vertical-bottom .collection-card__content {
    justify-content: flex-end;
  }

  .collection-card__title {
    margin: 0;
    color: inherit;
  }

  .collection-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .collection-card__title a:hover {
    text-decoration: underline;
  }

  .collection-card--placement-on_image .collection-card__title,
  .collection-card--placement-on_image .collection-card__title a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kollektionskarte",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Kollektionsname anzeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "title_preset",
      "label": "Überschriften-Voreinstellung",
      "options": [
        {
          "value": "h1",
          "label": "Überschrift 1"
        },
        {
          "value": "h2",
          "label": "Überschrift 2"
        },
        {
          "value": "h3",
          "label": "Überschrift 3"
        }
      ],
      "default": "h3",
      "visible_if": "{{ block.settings.show_title }}"
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Platzierung",
      "options": [
        {
          "value": "on_image",
          "label": "Auf dem Bild"
        },
        {
          "value": "below_image",
          "label": "Unter dem Bild"
        }
      ],
      "default": "below_image"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Oben"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "bottom",
          "label": "Unten"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.placement == 'on_image' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Vertikaler Abstand",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Seitenverhältnis",
      "options": [
        {
          "value": "auto",
          "label": "Automatisch"
        },
        {
          "value": "3 / 4",
          "label": "Hochformat"
        },
        {
          "value": "4 / 3",
          "label": "Querformat"
        },
        {
          "value": "1 / 1",
          "label": "Quadrat"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Erscheinungsbild"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Innenabstand",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Ränder"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Stil",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Stärke",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Deckkraft",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Farbe",
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kollektionskarte"
    }
  ]
}
{% endschema %}