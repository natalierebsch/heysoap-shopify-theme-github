<div
  class="
    custom-liquid-block
    custom-liquid-block--desktop-{{ block.settings.desktop_width }}
    custom-liquid-block--mobile-{{ block.settings.mobile_width }}
  "
  style="
    --custom-liquid-width-desktop: {{ block.settings.custom_width_desktop }}%;
    --custom-liquid-width-mobile: {{ block.settings.custom_width_mobile }}%;
    --custom-liquid-padding-top: {{ block.settings.padding_top }}px;
    --custom-liquid-padding-bottom: {{ block.settings.padding_bottom }}px;
    --custom-liquid-padding-left: {{ block.settings.padding_left }}px;
    --custom-liquid-padding-right: {{ block.settings.padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.custom_liquid }}
</div>

{% stylesheet %}
  .custom-liquid-block {
    box-sizing: border-box;
    max-width: 100%;
    padding:
      var(--custom-liquid-padding-top)
      var(--custom-liquid-padding-right)
      var(--custom-liquid-padding-bottom)
      var(--custom-liquid-padding-left);
  }

  .custom-liquid-block--desktop-fit {
    width: fit-content;
  }

  .custom-liquid-block--desktop-fill {
    width: 100%;
  }

  .custom-liquid-block--desktop-custom {
    width: var(--custom-liquid-width-desktop);
  }

  @media screen and (max-width: 749px) {
    .custom-liquid-block--mobile-fit {
      width: fit-content;
    }

    .custom-liquid-block--mobile-fill {
      width: 100%;
    }

    .custom-liquid-block--mobile-custom {
      width: var(--custom-liquid-width-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benutzerdefiniertes Liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid-Code",
      "info": "HTML und Shopify Liquid sind möglich. JavaScript sollte in einer Theme-Datei gepflegt werden."
    },
    {
      "type": "header",
      "content": "Größe"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop-Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_desktop",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.desktop_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte mobile Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.mobile_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Benutzerdefiniertes Liquid"
    }
  ]
}
{% endschema %}
