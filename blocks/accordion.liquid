<div class="accordion-block" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="accordion-block__heading">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="accordion-block__items">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .accordion-block {
    width: 100%;
  }

  .accordion-block__heading {
    margin-top: 0;
    margin-bottom: 20px;
  }

  .accordion-block__items {
    border-top: 1px solid currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Akkordeon",
  "blocks": [
    {
      "type": "accordion-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Häufig gestellte Fragen"
    }
  ],
  "presets": [
    {
      "name": "Akkordeon",
      "blocks": [
        {
          "type": "accordion-item",
          "settings": {
            "heading": "Erste Frage"
          }
        },
        {
          "type": "accordion-item",
          "settings": {
            "heading": "Zweite Frage"
          }
        }
      ]
    }
  ]
}
{% endschema %}