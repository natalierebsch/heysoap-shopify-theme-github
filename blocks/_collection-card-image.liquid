{% doc %}
  Rendert das Bild der nächstgelegenen Kollektion.

  @param {string} [parent_block_id] - ID des übergeordneten Kartenblocks.
{% enddoc %}

{% assign card_collection = closest.collection %}

<div
  class="
    collection-card-image
    collection-card-image--ratio-{{ block.settings.image_ratio }}
    collection-card-image--border-{{ block.settings.border }}
  "
  style="
    --collection-image-ratio: {{ block.settings.image_ratio }};
    --collection-image-radius: {{ block.settings.border_radius }}px;
    --collection-image-border-width: {{ block.settings.border_width }}px;
    --collection-image-border-color: {{ block.settings.border_color | default: 'currentColor' }};
    --collection-image-border-opacity: {{ block.settings.border_opacity }}%;
  "
  {{ block.shopify_attributes }}
>
  {% if card_collection != blank %}
    <a
      class="collection-card-image__link"
      href="{{ card_collection.url }}"
      aria-label="{{ card_collection.title | escape }}"
    >
      {% if card_collection.image != blank %}
        {{
          card_collection.image
          | image_url: width: 2000
          | image_tag:
            class: 'collection-card-image__image',
            loading: 'lazy',
            widths: '400, 750, 1000, 1500, 2000',
            sizes: '(max-width: 749px) 80vw, 33vw',
            alt: card_collection.title
        }}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'collection-card-image__placeholder' }}
      {% endif %}
    </a>
  {% else %}
    {{ 'collection-1' | placeholder_svg_tag: 'collection-card-image__placeholder' }}
  {% endif %}
</div>

{% stylesheet %}
  .collection-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: var(--collection-image-ratio);
    overflow: hidden;
    border-radius: var(--collection-image-radius);
  }

  .collection-card-image--ratio-auto {
    aspect-ratio: auto;
  }

  .collection-card-image--border-solid {
    border:
      var(--collection-image-border-width)
      solid
      color-mix(
        in srgb,
        var(--collection-image-border-color) var(--collection-image-border-opacity),
        transparent
      );
  }

  .collection-card-image__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .collection-card-image__image,
  .collection-card-image__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-card-image--ratio-auto .collection-card-image__image,
  .collection-card-image--ratio-auto .collection-card-image__placeholder {
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bild",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Seitenverhältnis",
      "options": [
        {
          "value": "auto",
          "label": "Automatisch"
        },
        {
          "value": "3 / 4",
          "label": "Hochformat"
        },
        {
          "value": "4 / 3",
          "label": "Querformat"
        },
        {
          "value": "1 / 1",
          "label": "Quadrat"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Ränder"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Stil",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Stärke",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Deckkraft",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Farbe",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
