<div
  class="
    card-block
    card-block--{{ block.settings.direction }}
    card-block--media-{{ block.settings.background_media }}
    {% if block.settings.link != blank %}card-block--linked{% endif %}
  "
  style="
    --card-direction: {{ block.settings.direction }};
    --card-alignment: {{ block.settings.alignment }};
    --card-position: {{ block.settings.position }};
    --card-gap: {{ block.settings.gap }}px;
    --card-background: {{ block.settings.background_color | default: 'transparent' }};
    --card-padding-top: {{ block.settings.padding_top }}px;
    --card-padding-bottom: {{ block.settings.padding_bottom }}px;
    --card-padding-left: {{ block.settings.padding_left }}px;
    --card-padding-right: {{ block.settings.padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_media == 'image' %}
    {% if block.settings.background_image != blank %}
      {{
        block.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'card-block__background-media',
          loading: 'lazy',
          widths: '400, 750, 1000, 1500, 2000',
          sizes: '(max-width: 749px) 100vw, 800px'
      }}
    {% endif %}
  {% elsif block.settings.background_media == 'video' %}
    {% if block.settings.background_video != blank %}
      {{
        block.settings.background_video
        | video_tag:
          class: 'card-block__background-media',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false
      }}
    {% endif %}
  {% endif %}

  {% if block.settings.media_overlay %}
    <div class="card-block__media-overlay" aria-hidden="true"></div>
  {% endif %}

  {% if block.settings.link != blank %}
    <a
      class="card-block__link-overlay"
      href="{{ block.settings.link }}"
      aria-label="Karte öffnen"
      {% if block.settings.open_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
    ></a>
  {% endif %}

  <div class="card-block__content">
    {% content_for 'block', type: 'image', id: 'card-image' %}
    {% content_for 'block', type: 'heading', id: 'card-heading' %}
    {% content_for 'block', type: 'text', id: 'card-text' %}
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .card-block {
    position: relative;
    width: 100%;
    padding:
      var(--card-padding-top)
      var(--card-padding-right)
      var(--card-padding-bottom)
      var(--card-padding-left);
    background-color: var(--card-background);
    box-sizing: border-box;
    overflow: hidden;
  }

  .card-block__background-media {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-block__media-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: rgb(0 0 0 / 35%);
    pointer-events: none;
  }

  .card-block__link-overlay {
    position: absolute;
    z-index: 3;
    inset: 0;
  }

  .card-block__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: var(--card-direction);
    align-items: var(--card-alignment);
    justify-content: var(--card-position);
    gap: var(--card-gap);
    width: 100%;
    min-height: inherit;
  }

  .card-block__content > .shopify-block {
    min-width: 0;
  }

  .card-block--vertical .card-block__content > .shopify-block {
    width: 100%;
  }

  .card-block--horizontal .card-block__content > .shopify-block {
    flex: 1 1 0;
  }

  .card-block--linked .card-block__content {
    pointer-events: none;
  }

  .card-block--linked .card-block__content a,
  .card-block--linked .card-block__content button,
  .card-block--linked .card-block__content input,
  .card-block--linked .card-block__content select,
  .card-block--linked .card-block__content textarea {
    position: relative;
    z-index: 4;
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .card-block--horizontal .card-block__content {
      flex-direction: column;
    }

    .card-block--horizontal .card-block__content > .shopify-block {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Karte",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Richtung",
      "options": [
        {
          "value": "vertical",
          "label": "Vertikal"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "flex-start",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "flex-end",
          "label": "Rechts"
        },
        {
          "value": "stretch",
          "label": "Füllen"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "flex-start",
          "label": "Oben"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "flex-end",
          "label": "Unten"
        },
        {
          "value": "space-between",
          "label": "Verteilt"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Erscheinungsbild"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "Hintergrundmedien",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "image",
          "label": "Bild"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hintergrundbild",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Hintergrundvideo",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "checkbox",
      "id": "media_overlay",
      "label": "Medienüberlagerung",
      "default": false
    },
    {
      "type": "header",
      "content": "Block-Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Link in neuem Tab öffnen",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Karte"
    }
  ]
}
{% endschema %}
