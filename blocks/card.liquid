{% liquid
  assign card_direction = 'column'
  if block.settings.direction == 'horizontal'
    assign card_direction = 'row'
  endif

  assign card_alignment = block.settings.alignment | default: 'flex-start'
  assign card_position = block.settings.position | default: 'center'
  assign card_gap = block.settings.gap | default: 12
  assign card_padding_top = block.settings.padding_top | default: 0
  assign card_padding_bottom = block.settings.padding_bottom | default: 0
  assign card_padding_left = block.settings.padding_left | default: 0
  assign card_padding_right = block.settings.padding_right | default: 0
  assign card_border_alpha = block.settings.border_opacity | divided_by: 100.0
  assign card_border_color = block.settings.border_color | default: '#000000'
  assign card_border_color = card_border_color | color_modify: 'alpha', card_border_alpha
%}

<div
  class="
    card-block
    card-block--{{ block.settings.direction }}
    card-block--desktop-{{ block.settings.desktop_width }}
    card-block--mobile-{{ block.settings.mobile_width }}
    card-block--height-{{ block.settings.height }}
    card-block--border-{{ block.settings.border }}
    card-block--media-{{ block.settings.background_media }}
    card-block--media-fit-{{ block.settings.media_fit }}
    {% if block.settings.vertical_on_mobile %}card-block--vertical-mobile{% endif %}
    {% if block.settings.link != blank %}card-block--linked{% endif %}
  "
  style="
    --card-direction: {{ card_direction }};
    --card-alignment: {{ card_alignment }};
    --card-position: {{ card_position }};
    --card-gap: {{ card_gap }}px;
    --card-background: {{ block.settings.background_color | default: 'transparent' }};
    --card-custom-width-desktop: {{ block.settings.custom_width_desktop }}%;
    --card-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    --card-custom-height: {{ block.settings.custom_height }}%;
    --card-overlay-color: {{ block.settings.overlay_color | default: '#00000026' }};
    --card-gradient-direction: {{ block.settings.gradient_direction }};
    --card-border-width: {{ block.settings.border_width }}px;
    --card-border-color: {{ card_border_color }};
    --card-border-radius: {{ block.settings.border_radius }}px;
    --card-padding-top: {{ card_padding_top }}px;
    --card-padding-bottom: {{ card_padding_bottom }}px;
    --card-padding-left: {{ card_padding_left }}px;
    --card-padding-right: {{ card_padding_right }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_media == 'image' %}
    {% if block.settings.background_image != blank %}
      {{
        block.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'card-block__background-media',
          loading: 'lazy',
          widths: '400, 750, 1000, 1500, 2000',
          sizes: '(max-width: 749px) 100vw, 800px'
      }}
    {% endif %}
  {% elsif block.settings.background_media == 'video' %}
    {% if block.settings.background_video != blank %}
      {{
        block.settings.background_video
        | video_tag:
          class: 'card-block__background-media',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false
      }}
    {% endif %}
  {% endif %}

  {% if block.settings.media_overlay %}
    <div
      class="card-block__media-overlay card-block__media-overlay--{{ block.settings.overlay_style }}"
      aria-hidden="true"
    ></div>
  {% endif %}

  {% if block.settings.link != blank %}
    <a
      class="card-block__link-overlay"
      href="{{ block.settings.link }}"
      aria-label="Karte öffnen"
      {% if block.settings.open_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
    ></a>
  {% endif %}

  <div class="card-block__content">
    {% content_for 'block', type: 'image', id: 'card-image' %}
    {% content_for 'block', type: 'heading', id: 'card-heading' %}
    {% content_for 'block', type: 'text', id: 'card-text' %}
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .card-block {
    position: relative;
    width: 100%;
    padding:
      var(--card-padding-top)
      var(--card-padding-right)
      var(--card-padding-bottom)
      var(--card-padding-left);
    background-color: var(--card-background);
    box-sizing: border-box;
    height: 100%;
    overflow: hidden;
    border-radius: var(--card-border-radius);
  }

  .card-block--desktop-fit {
    width: fit-content;
    max-width: 100%;
  }

  .card-block--desktop-custom {
    width: var(--card-custom-width-desktop);
    max-width: 100%;
  }

  .card-block--height-fit {
    height: fit-content;
  }

  .card-block--height-fill {
    height: 100%;
  }

  .card-block--height-custom {
    height: var(--card-custom-height);
    min-height: 1px;
  }

  .card-block--border-solid {
    border: var(--card-border-width) solid var(--card-border-color);
  }

  .card-block__background-media {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-block--media-fit-contain .card-block__background-media {
    object-fit: contain;
  }

  .card-block__media-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--card-overlay-color);
    pointer-events: none;
  }

  .card-block__media-overlay--gradient {
    background: linear-gradient(var(--card-gradient-direction), transparent, var(--card-overlay-color));
  }

  .card-block__link-overlay {
    position: absolute;
    z-index: 3;
    inset: 0;
  }

  .card-block__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: var(--card-direction);
    align-items: var(--card-alignment);
    justify-content: var(--card-position);
    gap: var(--card-gap);
    width: 100%;
    height: 100%;
  }

  .card-block__content > .shopify-block {
    min-width: 0;
  }

  .card-block--vertical .card-block__content > .shopify-block {
    width: auto;
    max-width: 100%;
    align-self: var(--card-alignment);
  }

  .card-block--horizontal .card-block__content > .shopify-block {
    flex: 1 1 0;
    align-self: var(--card-alignment);
  }

  .card-block--linked .card-block__content {
    pointer-events: none;
  }

  .card-block--linked .card-block__content a,
  .card-block--linked .card-block__content button,
  .card-block--linked .card-block__content input,
  .card-block--linked .card-block__content select,
  .card-block--linked .card-block__content textarea {
    position: relative;
    z-index: 4;
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .card-block--horizontal.card-block--vertical-mobile .card-block__content {
      flex-direction: column;
    }

    .card-block--horizontal.card-block--vertical-mobile .card-block__content > .shopify-block {
      width: 100%;
    }

    .card-block--mobile-fit {
      width: fit-content;
      max-width: 100%;
    }

    .card-block--mobile-fill {
      width: 100%;
    }

    .card-block--mobile-custom {
      width: var(--card-custom-width-mobile);
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Karte",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Richtung",
      "options": [
        {
          "value": "vertical",
          "label": "Vertikal"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "Vertikal auf Mobilgeräten",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "flex-start",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "flex-end",
          "label": "Rechts"
        },
        {
          "value": "stretch",
          "label": "Füllen"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "flex-start",
          "label": "Oben"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "flex-end",
          "label": "Unten"
        },
        {
          "value": "space-between",
          "label": "Verteilt"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Größe"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop-Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_desktop",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.desktop_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte mobile Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.mobile_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Höhe",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Benutzerdefinierte Höhe",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Erscheinungsbild"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "Hintergrundmedien",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "image",
          "label": "Bild"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Medienanpassung",
      "options": [
        { "value": "cover", "label": "Ausfüllen" },
        { "value": "contain", "label": "Einpassen" }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media != 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hintergrundbild",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Hintergrundvideo",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "checkbox",
      "id": "media_overlay",
      "label": "Medienüberlagerung",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Farbe der Überlagerung",
      "default": "#00000026",
      "alpha": true,
      "visible_if": "{{ block.settings.media_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Stil der Überlagerung",
      "options": [
        { "value": "solid", "label": "Einfarbig" },
        { "value": "gradient", "label": "Verlauf" }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.media_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Verlaufsrichtung",
      "options": [
        { "value": "to top", "label": "Nach oben" },
        { "value": "to bottom", "label": "Nach unten" }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.media_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Block-Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Link in neuem Tab öffnen",
      "default": false
    },
    {
      "type": "header",
      "content": "Ränder"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Stil",
      "options": [
        { "value": "none", "label": "Keine" },
        { "value": "solid", "label": "Einfarbig" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Stärke",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Deckkraft",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Farbe",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Karte"
    }
  ]
}
{% endschema %}
