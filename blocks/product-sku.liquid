{% liquid
  assign sku_product = closest.product
  assign sku_variant = sku_product.selected_or_first_available_variant
%}

{% if sku_product != blank %}
  <div
    class="
      product-sku-block
      typography-style
      product-sku-block--width-{{ block.settings.width }}
      product-sku-block--alignment-{{ block.settings.alignment }}
    "
    style="
      --product-sku-color: {{ block.settings.text_color | default: 'inherit' }};
      --product-sku-padding-top: {{ block.settings.padding_top }}px;
      --product-sku-padding-bottom: {{ block.settings.padding_bottom }}px;
      --product-sku-padding-left: {{ block.settings.padding_left }}px;
      --product-sku-padding-right: {{ block.settings.padding_right }}px;
      {% render 'typography-variables',
        preset: block.settings.type_preset,
        custom_font: block.settings.custom_font,
        custom_size: block.settings.custom_size,
        custom_line_height: block.settings.custom_line_height,
        custom_letter_spacing: block.settings.custom_letter_spacing,
        custom_case: block.settings.custom_case,
        custom_wrap: block.settings.custom_wrap
      %}
    "
    {% if sku_variant.sku == blank %}
      hidden
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {% if block.settings.show_label %}
      <span class="product-sku-block__label">{{ block.settings.label }}</span>
    {% endif %}
    <span class="product-sku-block__value">{{ sku_variant.sku }}</span>
  </div>
{% endif %}

{% stylesheet %}
  .product-sku-block {
    box-sizing: border-box;
    color: var(--product-sku-color);
    padding:
      var(--product-sku-padding-top)
      var(--product-sku-padding-right)
      var(--product-sku-padding-bottom)
      var(--product-sku-padding-left);
  }

  .product-sku-block[hidden] {
    display: none;
  }

  .product-sku-block--width-fit {
    width: fit-content;
    max-width: 100%;
  }

  .product-sku-block--width-fill {
    width: 100%;
  }

  .product-sku-block--alignment-left {
    text-align: left;
  }

  .product-sku-block--alignment-center {
    text-align: center;
  }

  .product-sku-block--alignment-right {
    text-align: right;
  }

  .product-sku-block__label {
    margin-right: 0.35em;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produkt-SKU",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Beschriftung anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Beschriftung",
      "default": "SKU:",
      "visible_if": "{{ block.settings.show_label }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Breite",
      "options": [
        { "value": "fit", "label": "Anpassen" },
        { "value": "fill", "label": "Füllen" }
      ],
      "default": "fill"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Ausrichtung",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Voreinstellung",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "paragraph", "label": "Absatz" },
        { "value": "h1", "label": "Überschrift 1" },
        { "value": "h2", "label": "Überschrift 2" },
        { "value": "h3", "label": "Überschrift 3" },
        { "value": "h4", "label": "Überschrift 4" },
        { "value": "h5", "label": "Überschrift 5" },
        { "value": "h6", "label": "Überschrift 6" },
        { "value": "custom", "label": "Benutzerdefiniert" }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "custom_font",
      "label": "Schriftart",
      "options": [
        { "value": "paragraph", "label": "Absatz" },
        { "value": "heading", "label": "Überschrift" },
        { "value": "heading_1", "label": "Überschrift 1" }
      ],
      "default": "paragraph",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_size",
      "label": "Größe",
      "min": 8,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_line_height",
      "label": "Zeilenhöhe",
      "options": [
        { "value": "1", "label": "Eng" },
        { "value": "normal", "label": "Normal" },
        { "value": "1.5", "label": "Weit" }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_letter_spacing",
      "label": "Zeichenabstand",
      "options": [
        { "value": "-0.02em", "label": "Eng" },
        { "value": "normal", "label": "Normal" },
        { "value": "0.05em", "label": "Weit" }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_case",
      "label": "Schreibweise",
      "options": [
        { "value": "none", "label": "Standard" },
        { "value": "uppercase", "label": "Großbuchstaben" }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_wrap",
      "label": "Umbruch",
      "options": [
        { "value": "wrap", "label": "Standard" },
        { "value": "pretty", "label": "Hübsch" },
        { "value": "balance", "label": "Ausgeglichen" },
        { "value": "nowrap", "label": "Kein Umbruch" }
      ],
      "default": "pretty",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Produkt-SKU"
    }
  ]
}
{% endschema %}
