{% liquid
  assign button_background = block.settings.background_color
  assign button_text = block.settings.text_color
  assign button_border = block.settings.border_color

  if block.settings.style == 'solid'
    assign button_background = button_background | default: '#111111'
    assign button_text = button_text | default: '#ffffff'
    assign button_border = button_border | default: button_background
  elsif block.settings.style == 'outline'
    assign button_background = button_background | default: 'transparent'
    assign button_text = button_text | default: '#111111'
    assign button_border = button_border | default: button_text
  endif
%}

{% if block.settings.label != blank %}
  <div
    class="button-block button-block--{{ block.settings.style }}"
    style="
      --button-alignment: {{ block.settings.alignment }};
      --button-background: {{ button_background }};
      --button-text: {{ button_text }};
      --button-border: {{ button_border }};
      --button-radius: {{ block.settings.border_radius }}px;
      --button-width: {% if block.settings.width == 'custom' %}{{ block.settings.custom_width }}%{% else %}{{ block.settings.width }}{% endif %};
      --button-width-mobile: {% if block.settings.width_mobile == 'custom' %}{{ block.settings.custom_width_mobile }}%{% else %}{{ block.settings.width_mobile }}{% endif %};
    "
    {{ block.shopify_attributes }}
  >
    <a
      href="{{ block.settings.link | default: '#' }}"
      class="button-block__button"
      {% if block.settings.open_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
    >
      {{ block.settings.label }}
    </a>
  </div>
{% endif %}

{% stylesheet %}
  .button-block {
    text-align: var(--button-alignment);
  }

  .button-block__button {
    display: inline-flex;
    box-sizing: border-box;
    width: var(--button-width);
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 1px solid var(--button-border);
    border-radius: var(--button-radius);
    background: var(--button-background);
    color: var(--button-text);
    text-align: center;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .button-block--link .button-block__button {
    min-height: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--button-text, inherit);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .button-block__button:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .button-block__button {
      width: var(--button-width-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Schaltfläche",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Beschriftung",
      "default": "Mehr erfahren"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "In neuem Tab öffnen",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "Stil",
      "options": [
        {
          "value": "solid",
          "label": "Primär"
        },
        {
          "value": "outline",
          "label": "Sekundär"
        },
        {
          "value": "link",
          "label": "Link"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Benutzerdefinierte Farben",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "visible_if": "{{ block.settings.style == 'custom' or block.settings.style == 'link' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Randfarbe",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.style != 'link' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Ausrichtung",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Größe"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Desktop-Breite",
      "options": [
        {
          "value": "fit-content",
          "label": "Anpassen"
        },
        {
          "value": "100%",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Benutzerdefinierte Desktop-Breite",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Mobile Breite",
      "options": [
        {
          "value": "fit-content",
          "label": "Anpassen"
        },
        {
          "value": "100%",
          "label": "Füllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte mobile Breite",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Schaltfläche"
    }
  ]
}
{% endschema %}
