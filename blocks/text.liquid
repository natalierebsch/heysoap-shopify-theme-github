<div class="text-block" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Gib hier deinen Text ein.</p>"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}