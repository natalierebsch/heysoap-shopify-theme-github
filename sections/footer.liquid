<footer
  class="site-footer"
  style="
    --footer-background: {{ section.settings.background_color | default: 'transparent' }};
    --footer-text-color: {{ section.settings.text_color | default: 'inherit' }};
    --footer-padding-top: {{ section.settings.padding_top }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="site-footer__inner">
    <div class="site-footer__content">
      <div class="site-footer__brand">
        {% if section.settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="site-footer__logo-link">
            {{
              section.settings.logo
              | image_url: width: 800
              | image_tag:
                class: 'site-footer__logo',
                loading: 'lazy',
                widths: '120, 240, 400, 600, 800',
                width: section.settings.logo_width,
                alt: shop.name
            }}
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="site-footer__shop-name">
            {{ shop.name }}
          </a>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="site-footer__text">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.menu != blank %}
        <nav class="site-footer__navigation" aria-label="Footer-Navigation">
          {% if section.settings.menu_heading != blank %}
            <h2 class="site-footer__heading">
              {{ section.settings.menu_heading }}
            </h2>
          {% endif %}

          <ul class="site-footer__menu" role="list">
            {% for link in section.settings.menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </div>

    <div class="site-footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>

      {% if section.settings.show_payment_icons %}
        <div class="site-footer__payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    box-sizing: border-box;
    width: 100%;
    color: var(--footer-text-color);
    background-color: var(--footer-background);
    padding-top: var(--footer-padding-top);
    padding-bottom: var(--footer-padding-bottom);
  }

  .site-footer__inner {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .site-footer__content {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(180px, 1fr);
    gap: 48px;
  }

  .site-footer__brand {
    max-width: 600px;
  }

  .site-footer__logo-link {
    display: inline-block;
  }

  .site-footer__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }

  .site-footer__shop-name {
    color: inherit;
    font-size: 24px;
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer__text {
    margin-top: 20px;
  }

  .site-footer__text p {
    margin: 0;
  }

  .site-footer__text p + p {
    margin-top: 1em;
  }

  .site-footer__heading {
    margin: 0 0 16px;
    font-size: 18px;
  }

  .site-footer__menu {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__menu a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__menu a:hover {
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid currentColor;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-footer__payment-icons svg {
    width: 38px;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .site-footer__inner {
      padding-inline: 16px;
    }

    .site-footer__content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo-Breite",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Erzähle deinen Kunden etwas über dein Unternehmen.</p>"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Überschrift",
      "default": "Informationen"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü"
    },
    {
      "type": "header",
      "content": "Erscheinungsbild"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Zahlungssymbole anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}