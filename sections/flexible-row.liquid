<div
  class="
    block-carousel
    block-carousel--{{ section.settings.background_style }}
    block-carousel--height-{{ section.settings.card_height }}
  "
  style="
    --carousel-background: {{ section.settings.background_color }};
    --carousel-gap: {{ section.settings.gap }}px;
    --carousel-columns-desktop: {{ section.settings.columns_desktop }};
    --carousel-columns-mobile: {{ section.settings.columns_mobile }};
    --carousel-max-width: {{ section.settings.max_width }}px;

    --carousel-padding-top: {{ section.settings.padding_top }}px;
    --carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
    --carousel-padding-left: {{ section.settings.padding_left }}px;
    --carousel-padding-right: {{ section.settings.padding_right }}px;

    --carousel-border-style: {{ section.settings.border_style }};
    --carousel-border-width: {{ section.settings.border_width }}px;
    --carousel-border-color: {{ section.settings.border_color }};
    --carousel-border-radius: {{ section.settings.border_radius }}px;

    --carousel-card-position: {{ section.settings.card_position }};
  "
>
  <div class="block-carousel__container">
    <div class="block-carousel__viewport">
      <div class="block-carousel__track" data-carousel-track>
        {% content_for 'blocks' %}
      </div>
    </div>

    <button
      class="block-carousel__arrow block-carousel__arrow--previous"
      type="button"
      data-carousel-direction="-1"
      aria-label="Vorherige Karten"
    >
      &#10094;
    </button>

    <button
      class="block-carousel__arrow block-carousel__arrow--next"
      type="button"
      data-carousel-direction="1"
      aria-label="Nächste Karten"
    >
      &#10095;
    </button>
  </div>
</div>

{% stylesheet %}
  .block-carousel {
    width: 100%;
    padding:
      var(--carousel-padding-top)
      var(--carousel-padding-right)
      var(--carousel-padding-bottom)
      var(--carousel-padding-left);
  }

  .block-carousel--none {
    background: transparent;
  }

  .block-carousel--solid {
    background-color: var(--carousel-background);
  }

  .block-carousel__container {
    position: relative;
    width: min(100%, var(--carousel-max-width));
    margin-inline: auto;
    border-width: var(--carousel-border-width);
    border-style: var(--carousel-border-style);
    border-color: var(--carousel-border-color);
    border-radius: var(--carousel-border-radius);
    overflow: hidden;
  }

  .block-carousel__viewport {
    width: 100%;
    overflow: hidden;
  }

  .block-carousel__track {
    display: flex;
    gap: var(--carousel-gap);
    width: 100%;
    padding: var(--carousel-gap);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .block-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .block-carousel__track > .shopify-block {
    display: flex;
    flex: 0 0 calc(
      (
        100% - (var(--carousel-gap) * (var(--carousel-columns-desktop) - 1))
      ) / var(--carousel-columns-desktop)
    );
    min-width: 0;
    align-items: var(--carousel-card-position);
    scroll-snap-align: start;
  }

  .block-carousel__track > .shopify-block > * {
    width: 100%;
  }

  .block-carousel--height-adapt .block-carousel__track {
    align-items: flex-start;
  }

  .block-carousel--height-adapt .block-carousel__track > .shopify-block {
    align-self: flex-start;
  }

  .block-carousel--height-fill .block-carousel__track {
    align-items: stretch;
  }

  .block-carousel--height-fill .block-carousel__track > .shopify-block {
    align-self: stretch;
  }

  .block-carousel--height-fill .card-block {
    height: 100%;
  }

  .block-carousel__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 15%);
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
    transform: translateY(-50%);
  }

  .block-carousel__arrow--previous {
    left: 12px;
  }

  .block-carousel__arrow--next {
    right: 12px;
  }

  .block-carousel__arrow:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .block-carousel__track > .shopify-block {
      flex-basis: calc(
        (
          100% - (var(--carousel-gap) * (var(--carousel-columns-mobile) - 1))
        ) / var(--carousel-columns-mobile)
      );
    }

    .block-carousel__arrow {
      width: 38px;
      height: 38px;
    }

    .block-carousel__arrow--previous {
      left: 6px;
    }

    .block-carousel__arrow--next {
      right: 6px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-carousel-direction]');

    if (!button) {
      return;
    }

    const carousel = button.closest('.block-carousel');
    const track = carousel.querySelector('[data-carousel-track]');

    if (!track) {
      return;
    }

    const direction = Number(button.dataset.carouselDirection);

    track.scrollBy({
      left: track.clientWidth * direction,
      behavior: 'smooth'
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Karten-Karussell",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Sichtbare Karten Desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Sichtbare Karten Mobil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand zwischen Karten",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "card_height",
      "label": "Kartenhöhe",
      "options": [
        {
          "value": "adapt",
          "label": "An Inhalt anpassen"
        },
        {
          "value": "fill",
          "label": "Gleiche Höhe"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Position der Karten",
      "options": [
        {
          "value": "flex-start",
          "label": "Oben"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "flex-end",
          "label": "Unten"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximale Breite",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Hintergrund"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Stil",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Rand"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Randstil",
      "options": [
        {
          "value": "none",
          "label": "Kein Rand"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Randbreite",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Randfarbe",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Innenabstand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Karten-Karussell",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
