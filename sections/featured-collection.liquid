{% liquid
  assign featured_collection = section.settings.collection
  assign featured_heading = featured_collection.title
  assign featured_url = featured_collection.url

  if section.settings.product_source == 'all'
    assign featured_collection = collections['all']
    assign featured_heading = 'Alle Produkte'
    assign featured_url = routes.all_products_collection_url
  endif
%}

<section
  class="
    featured-collection
    featured-collection--{{ section.settings.width }}
    featured-collection--{{ section.settings.layout_type }}
    {% if section.settings.carousel_on_mobile %}featured-collection--mobile-carousel{% endif %}
  "
  style="
    --featured-columns-desktop: {{ section.settings.columns_desktop }};
    --featured-columns-mobile: {{ section.settings.columns_mobile }};
    --featured-column-gap: {{ section.settings.column_gap }}px;
    --featured-row-gap: {{ section.settings.row_gap }}px;
    --featured-mobile-card-width: {{ section.settings.mobile_card_width }}%;
    --featured-section-background: {{ section.settings.background_color | default: 'transparent' }};
    --featured-padding-top: {{ section.settings.padding_top }}px;
    --featured-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="featured-collection__inner">
    {% content_for 'block',
      type: '_featured-collection-heading',
      id: 'featured-collection-heading',
      closest.collection: featured_collection,
      heading_text: featured_heading,
      heading_url: featured_url
    %}

    <div class="featured-collection__additional">
      {% content_for 'blocks', closest.collection: featured_collection %}
    </div>

    {% if featured_collection != blank %}
      <div class="featured-collection__grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <div class="featured-collection__item">
            {% content_for 'block',
              type: '_featured-product-card',
              id: 'featured-product-card',
              closest.product: product
            %}
          </div>
        {% endfor %}
      </div>
      {% if section.settings.layout_type == 'carousel' %}
        <div class="featured-collection__navigation" aria-label="Karussell-Navigation">
          <button type="button" class="featured-collection__previous" aria-label="Zurück">←</button>
          <button type="button" class="featured-collection__next" aria-label="Weiter">→</button>
        </div>
      {% endif %}
    {% else %}
      <div class="featured-collection__empty">
        Wähle in den Section-Einstellungen eine Kollektion aus.
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .featured-collection {
    box-sizing: border-box;
    width: 100%;
    background: var(--featured-section-background);
    padding-block: var(--featured-padding-top) var(--featured-padding-bottom);
  }

  .featured-collection__inner {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    margin-inline: auto;
  }

  .featured-collection--page .featured-collection__inner {
    max-width: var(--page-width, 1920px);
    padding-inline: 20px;
  }

  .featured-collection--full {
    width: 100cqw;
    max-width: 100cqw;
    margin-left: calc(50% - 50cqw);
  }

  .featured-collection--full .featured-collection__inner {
    padding-inline: 20px;
  }

  .featured-collection__additional {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .featured-collection__additional:empty {
    display: none;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--featured-columns-desktop), minmax(0, 1fr));
    column-gap: var(--featured-column-gap);
    row-gap: var(--featured-row-gap);
  }

  .featured-collection__item {
    min-width: 0;
  }

  .featured-collection__item > .shopify-block {
    height: 100%;
  }

  .featured-collection__empty {
    padding: 32px;
    border: 1px dashed currentColor;
    text-align: center;
  }

  .featured-collection--carousel .featured-collection__grid {
    display: flex;
    gap: var(--featured-column-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .featured-collection--carousel .featured-collection__grid::-webkit-scrollbar {
    display: none;
  }

  .featured-collection--carousel .featured-collection__item {
    flex: 0 0 calc(
      (100% - (var(--featured-columns-desktop) - 1) * var(--featured-column-gap))
      / var(--featured-columns-desktop)
    );
    scroll-snap-align: start;
  }

  .featured-collection--editorial .featured-collection__grid {
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .featured-collection--editorial .featured-collection__item {
    grid-column: span 4;
  }

  .featured-collection--editorial .featured-collection__item:nth-child(5n + 1),
  .featured-collection--editorial .featured-collection__item:nth-child(5n + 2) {
    grid-column: span 6;
  }

  .featured-collection__navigation {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .featured-collection__navigation button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .featured-collection--page .featured-collection__inner,
    .featured-collection--full .featured-collection__inner {
      padding-inline: 12px;
    }

    .featured-collection__grid {
      grid-template-columns: repeat(var(--featured-columns-mobile), minmax(0, 1fr));
    }

    .featured-collection--editorial .featured-collection__item {
      grid-column: span 6;
    }

    .featured-collection--carousel .featured-collection__item,
    .featured-collection--mobile-carousel .featured-collection__item {
      flex: 0 0 var(--featured-mobile-card-width);
    }

    .featured-collection--mobile-carousel .featured-collection__grid {
      display: flex;
      gap: var(--featured-column-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .featured-collection--mobile-carousel .featured-collection__grid::-webkit-scrollbar {
      display: none;
    }

    .featured-collection--mobile-carousel .featured-collection__item {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const button = event.target.closest('.featured-collection__previous, .featured-collection__next');
    if (!button) return;

    const section = button.closest('.featured-collection');
    const grid = section?.querySelector('.featured-collection__grid');
    if (!grid) return;

    const direction = button.classList.contains('featured-collection__next') ? 1 : -1;
    grid.scrollBy({ left: direction * grid.clientWidth * 0.8, behavior: 'smooth' });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "blocks": [
    { "type": "@theme" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "image" },
    { "type": "spacer" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "product_source",
      "label": "Produktauswahl",
      "options": [
        {
          "value": "collection",
          "label": "Kollektion"
        },
        {
          "value": "all",
          "label": "Alle Produkte"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion",
      "info": "Wird nur verwendet, wenn bei der Produktauswahl „Kollektion“ gewählt ist."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Anzahl Produkte",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Darstellung",
      "options": [
        { "value": "grid", "label": "Raster" },
        { "value": "carousel", "label": "Karussell" },
        { "value": "editorial", "label": "Editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Auf Mobilgeräten als Karussell",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Spalten Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Spalten Mobil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Horizontaler Abstand",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Vertikaler Abstand",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Kartenbreite Mobil",
      "min": 40,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 75
    },
    {
      "type": "select",
      "id": "width",
      "label": "Breite",
      "options": [
        { "value": "page", "label": "Seite" },
        { "value": "full", "label": "Vollständig" }
      ],
      "default": "page"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
