{% capture product_gallery %}
  {% content_for 'block', type: 'product-gallery', id: 'product-gallery', closest.product: product %}
{% endcapture %}

<section
  class="
    product-main
    product-main--gallery-{{ section.settings.gallery_position }}
    product-main--width-{{ section.settings.width }}
  "
  style="
    --product-main-gallery-width: {{ section.settings.gallery_width }}%;
    --product-main-gap: {{ section.settings.gap }}px;
    --product-main-background: {{ section.settings.background_color | default: 'transparent' }};
    --product-main-padding-top: {{ section.settings.padding_top }}px;
    --product-main-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-main-padding-left: {{ section.settings.padding_left }}px;
    --product-main-padding-right: {{ section.settings.padding_right }}px;
  "
>
  <div class="product-main__inner">
    <div class="product-main__gallery">
      {{ product_gallery }}
    </div>

    <div class="product-main__information{% if section.settings.sticky_information %} product-main__information--sticky{% endif %}">
      {% content_for 'blocks', closest.product: product %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-main {
    box-sizing: border-box;
    width: 100%;
    background: var(--product-main-background);
    padding:
      var(--product-main-padding-top)
      var(--product-main-padding-right)
      var(--product-main-padding-bottom)
      var(--product-main-padding-left);
  }

  .product-main--width-page {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .product-main__inner {
    display: grid;
    grid-template-columns: minmax(0, var(--product-main-gallery-width)) minmax(0, 1fr);
    align-items: start;
    gap: var(--product-main-gap);
  }

  .product-main--gallery-right .product-main__gallery {
    order: 2;
  }

  .product-main__information {
    display: flex;
    flex-direction: column;
    gap: var(--product-main-gap);
    min-width: 0;
  }

  .product-main__information--sticky {
    position: sticky;
    top: 24px;
  }

  @media screen and (max-width: 749px) {
    .product-main__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-main--gallery-right .product-main__gallery {
      order: initial;
    }

    .product-main__information--sticky {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produktbereich",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "gallery_position",
      "label": "Position der Galerie",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gallery_width",
      "label": "Galeriebreite",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 58
    },
    {
      "type": "checkbox",
      "id": "sticky_information",
      "label": "Produktinformationen beim Scrollen fixieren",
      "default": true
    },
    {
      "type": "select",
      "id": "width",
      "label": "Breite",
      "options": [
        { "value": "page", "label": "Seite" },
        { "value": "full", "label": "Vollständig" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
