<div
  class="
    carousel
    carousel--{{ section.settings.background_style }}
    carousel--width-{{ section.settings.width }}
  "
  style="
    --carousel-background: {{ section.settings.background_color }};
    --carousel-gap: {{ section.settings.gap }}px;

    --carousel-padding-top: {{ section.settings.padding_top }}px;
    --carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
    --carousel-padding-left: {{ section.settings.padding_left }}px;
    --carousel-padding-right: {{ section.settings.padding_right }}px;

    --carousel-border-style: {{ section.settings.border_style }};
    --carousel-border-width: {{ section.settings.border_width }}px;
    --carousel-border-color: {{ section.settings.border_color }};
    --carousel-border-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="carousel__inner">
    {% content_for 'block',
      type: 'heading',
      id: 'carousel-heading'
    %}

    {% content_for 'block',
      type: 'carousel-content',
      id: 'carousel-content'
    %}
  </div>
</div>

{% stylesheet %}
  .carousel {
    width: 100%;
    padding:
      var(--carousel-padding-top)
      var(--carousel-padding-right)
      var(--carousel-padding-bottom)
      var(--carousel-padding-left);
  }

  .carousel--none {
    background: transparent;
  }

  .carousel--solid {
    background: var(--carousel-background);
  }

  .carousel__inner {
    display: flex;
    flex-direction: column;
    gap: var(--carousel-gap);
    width: 100%;
    margin-inline: auto;
    border-width: var(--carousel-border-width);
    border-style: var(--carousel-border-style);
    border-color: var(--carousel-border-color);
    border-radius: var(--carousel-border-radius);
    overflow: hidden;
  }

  .carousel--width-page .carousel__inner {
    max-width: 1200px;
  }

  .carousel--width-full .carousel__inner {
    max-width: none;
  }

  .carousel__inner > .shopify-block {
    width: 100%;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-carousel-direction]');

    if (!button) {
      return;
    }

    const carousel = button.closest('.carousel');
    const track = carousel.querySelector('[data-carousel-track]');

    if (!track) {
      return;
    }

    const direction = Number(button.dataset.carouselDirection);

    track.scrollBy({
      left: track.clientWidth * direction,
      behavior: 'smooth'
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Karussell",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Breite",
      "options": [
        {
          "value": "page",
          "label": "Seite"
        },
        {
          "value": "full",
          "label": "Vollständig"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand zwischen Überschrift und Inhalt",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Hintergrundstil",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#f5f5f5"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Randstil",
      "options": [
        {
          "value": "none",
          "label": "Kein Rand"
        },
        {
          "value": "solid",
          "label": "Einfarbig"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Randbreite",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Randfarbe",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding links",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding rechts",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Karussell"
    }
  ]
}
{% endschema %}