<div
  class="
    carousel
    carousel--width-{{ section.settings.width }}
    carousel--navigation-{{ section.settings.navigation_background }}
  "
  style="
    --carousel-background: {{ section.settings.background_color | default: 'transparent' }};
    --carousel-columns-desktop: {{ section.settings.columns_desktop }};
    --carousel-columns-mobile: {{ section.settings.columns_mobile }};
    --carousel-card-gap: {{ section.settings.horizontal_gap }}px;
    --carousel-padding-top: {{ section.settings.padding_top }}px;
    --carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="carousel__inner">
    {% content_for 'block', type: 'heading', id: 'carousel-heading' %}
    {% content_for 'block', type: 'carousel-content', id: 'carousel-content' %}
  </div>
</div>

{% stylesheet %}
  .carousel {
    width: 100%;
    padding-block: var(--carousel-padding-top) var(--carousel-padding-bottom);
    background: var(--carousel-background);
  }

  .carousel__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    margin-inline: auto;
  }

  .carousel--width-page .carousel__inner {
    max-width: var(--page-width, 1200px);
    padding-inline: 20px;
  }

  .carousel--width-full {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .carousel--width-full .carousel__inner {
    max-width: none;
  }

  .carousel__inner > .shopify-block {
    width: 100%;
  }

  .carousel--navigation-none .carousel-content__arrow {
    border-color: transparent;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .carousel--navigation-circle .carousel-content__arrow {
    border-radius: 50%;
  }

  .carousel--navigation-square .carousel-content__arrow {
    border-radius: 0;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-carousel-direction]');

    if (!button) {
      return;
    }

    const carousel = button.closest('.carousel');
    const track = carousel.querySelector('[data-carousel-track]');

    if (!track) {
      return;
    }

    const direction = Number(button.dataset.carouselDirection);

    track.scrollBy({
      left: track.clientWidth * direction,
      behavior: 'smooth'
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Karussell",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Spalten",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Spalten",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Breite",
      "options": [
        {
          "value": "page",
          "label": "Seite"
        },
        {
          "value": "full",
          "label": "Vollständig"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "Horizontaler Abstand",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "select",
      "id": "navigation_symbol",
      "label": "Symbol",
      "options": [
        {
          "value": "arrows",
          "label": "Pfeile"
        },
        {
          "value": "chevrons",
          "label": "Winkel"
        }
      ],
      "default": "arrows"
    },
    {
      "type": "select",
      "id": "navigation_background",
      "label": "Symbolhintergrund",
      "options": [
        {
          "value": "none",
          "label": "Keine"
        },
        {
          "value": "circle",
          "label": "Kreis"
        },
        {
          "value": "square",
          "label": "Quadrat"
        }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Karussell"
    }
  ]
}
{% endschema %}
