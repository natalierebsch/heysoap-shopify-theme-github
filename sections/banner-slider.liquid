<div
  class="banner-slider"
  style="
    --slider-height-desktop: {{ section.settings.height_desktop }}px;
    --slider-height-mobile: {{ section.settings.height_mobile }}px;
  "
>
  <div class="banner-slider__track" data-slider-track>
    {% for block in section.blocks %}
      <div
        class="banner-slider__slide"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          <picture class="banner-slider__picture">
            {% if block.settings.image_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.image_mobile | image_url: width: 1000 }}"
              >
            {% endif %}

            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: 'banner-slider__image',
                loading: 'lazy',
                widths: '750, 1100, 1500, 2000, 2400',
                sizes: '100vw'
            }}
          </picture>
        {% else %}
          <div class="banner-slider__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="banner-slider__overlay"></div>

        <div class="banner-slider__content">
          {% if block.settings.heading != blank %}
            <h2 class="banner-slider__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="banner-slider__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              class="banner-slider__button"
              href="{{ block.settings.button_link | default: '#' }}"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button
      class="banner-slider__arrow banner-slider__arrow--previous"
      type="button"
      data-slider-direction="-1"
      aria-label="Vorheriger Slide"
    >
      &#10094;
    </button>

    <button
      class="banner-slider__arrow banner-slider__arrow--next"
      type="button"
      data-slider-direction="1"
      aria-label="Nächster Slide"
    >
      &#10095;
    </button>
  {% endif %}
</div>

{% stylesheet %}
  .banner-slider {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .banner-slider__track {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .banner-slider__track::-webkit-scrollbar {
    display: none;
  }

  .banner-slider__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: var(--slider-height-desktop);
    overflow: hidden;
    scroll-snap-align: start;
  }

  .banner-slider__picture,
  .banner-slider__image,
  .banner-slider__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .banner-slider__image {
    object-fit: cover;
  }

  .banner-slider__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .banner-slider__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 35%);
  }

  .banner-slider__content {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(90%, 700px);
    color: #ffffff;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .banner-slider__heading {
    margin: 0 0 16px;
    color: inherit;
  }

  .banner-slider__text {
    margin-bottom: 24px;
  }

  .banner-slider__text p {
    margin: 0;
    color: inherit;
  }

  .banner-slider__button {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 4px;
    background: #ffffff;
    color: #111111;
    text-decoration: none;
  }

  .banner-slider__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 85%);
    color: #111111;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .banner-slider__arrow--previous {
    left: 20px;
  }

  .banner-slider__arrow--next {
    right: 20px;
  }

  @media screen and (max-width: 749px) {
    .banner-slider__slide {
      height: var(--slider-height-mobile);
    }

    .banner-slider__arrow {
      width: 38px;
      height: 38px;
    }

    .banner-slider__arrow--previous {
      left: 10px;
    }

    .banner-slider__arrow--next {
      right: 10px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-slider-direction]');

    if (!button) {
      return;
    }

    const slider = button.closest('.banner-slider');
    const track = slider.querySelector('[data-slider-track]');
    const direction = Number(button.dataset.sliderDirection);

    track.scrollBy({
      left: track.clientWidth * direction,
      behavior: 'smooth'
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Banner-Slider",
  "tag": "section",
  "class": "banner-slider-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Höhe Desktop",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Höhe Mobil",
      "min": 250,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 450
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobiles Bild"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Banner-Überschrift"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Beschreibe hier dein Angebot.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button-Beschriftung",
          "default": "Mehr erfahren"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button-Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner-Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}